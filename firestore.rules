rules_version = '2';

// RMS (Reservation Management System) — every account is its own tenant (own
// apartments/bookings/guests); regular users can never see each other's data.
// "Admin" is a platform-wide role: admins manage accounts (invite codes, roles,
// enabling/disabling and deleting users) and may READ any account's data for
// support, but can never WRITE another account's data. The owner (by email) and
// any "main admin" it designates are protected from other (regular) admins.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Privileged internal read — bypasses rules, safe to use inside conditions.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }

    // The bootstrap owner — hardcoded by email so it always matches the real
    // owner and can never be locked out. To change it, edit the email here and
    // in AdminView's OWNER_EMAIL.
    function isOwnerEmail(userData) {
      return userData.get('email', '').lower() == 'emynbusiness@gmail.com';
    }

    // "Main" admins are protected co-owners: the bootstrap owner, plus any admin
    // a main admin has granted mainAdmin:true. Only a main admin can manage or
    // grant/revoke other main admins.
    function isMainAdmin(userData) {
      return isOwnerEmail(userData) || userData.get('mainAdmin', false) == true;
    }
    function iAmMainAdmin() {
      return isAdmin() && isMainAdmin(myProfile());
    }

    // Every collection of business data is scoped to its owner's own uid.
    function isOwner(data) {
      return isSignedIn() && data.workspaceId == request.auth.uid;
    }

    // Owner who has NOT been disabled by an admin. Used to gate writes so a
    // disabled (or deleted) account can never modify data even with a live token.
    // .get(...) keeps this safe for accounts created before the field existed.
    function isActiveOwner(data) {
      return isOwner(data) && myProfile().get('disabled', false) != true;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ── the selling agency ──
    // An outside agency (MsEe Central) that brings bookings to accounts on this
    // platform. It signs in as its own account and writes bookings into accounts
    // that have asked it to.
    //
    // TWO SWITCHES, BOTH DELIBERATE, AND NEITHER CAN BE FLIPPED BY THE AGENCY:
    //
    //   agency:true on the agency's own user doc — only a main admin may set it
    //   (see the users update rule, which guards it exactly like mainAdmin).
    //   Without that guard any signed-in account could declare itself the agency
    //   by updating its own profile, which the self-update path allows.
    //
    //   agencyAccess:true on the account being sold for. The account's own owner
    //   can set it (that is their consent) and so can an admin managing them.
    //
    // What the agency may do is narrow: create a booking that is STAMPED as
    // theirs, correct or cancel one it created, and keep the night index on an
    // apartment in step. It can read (it is also an admin) but it can never
    // touch an apartment's details, a guest, or a booking the owner made.
    function iAmAgency() {
      return isSignedIn() && myProfile().get('agency', false) == true;
    }

    function accountWantsAgency(workspaceId) {
      return get(/databases/$(database)/documents/users/$(workspaceId))
        .data.get('agencyAccess', false) == true;
    }

    function isAgencyFor(workspaceId) {
      return iAmAgency() && accountWantsAgency(workspaceId);
    }

    // A booking the agency is creating must say so, in fields the owner's own
    // app never writes. That is what makes "who brought this booking" a fact in
    // the database rather than a label somebody can claim later.
    function isAgencyBooking(data) {
      return isAgencyFor(data.workspaceId)
        && data.source == 'MSEE'
        && data.createdVia == 'MSEE_CENTRAL'
        && data.createdByAgency == request.auth.uid
        && data.mseeReservationId is string
        && data.mseeReservationId.size() > 0;
    }

    // Only the booking it brought, and never its own stamp.
    function isMyAgencyBooking() {
      return isAgencyFor(resource.data.workspaceId)
        && resource.data.get('source', '') == 'MSEE'
        && resource.data.get('createdByAgency', '') == request.auth.uid;
    }

    // One-time bootstrap marker — created by the very first admin (via /setup).
    // Its mere existence permanently closes the no-invite-code admin bootstrap path.
    match /meta/setup {
      allow get: if true;
      allow create: if isSignedIn() && request.resource.data.completedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ── users ── (doc ID == uid; workspaceId always equals the doc's own uid)
    match /users/{userId} {
      // Admins can see every account (platform management); everyone can read their own doc.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.workspaceId == request.auth.uid &&
        (
          // Normal path: a valid, unused, active invite code fixes the role.
          (
            request.resource.data.inviteCode is string &&
            exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)) &&
            get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.active == true &&
            get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.usedBy == null &&
            get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.role == request.resource.data.role
          )
          ||
          // One-time bootstrap: only before /meta/setup exists, and only grants admin.
          (request.resource.data.role == 'admin' && !exists(/databases/$(database)/documents/meta/setup))
        );

      // workspaceId never changes. Only a main admin may set/clear the mainAdmin
      // flag. Then either: (self) update your own counters — and an admin who is
      // not the owner may also step down by changing their own role; or (admin)
      // manage another account, but never the owner, and a main admin only if you
      // are one. .get(...) tolerates docs created before a field existed.
      allow update: if isSignedIn() && unchanged('workspaceId')
        && (request.resource.data.get('mainAdmin', false) == resource.data.get('mainAdmin', false) || iAmMainAdmin())
        // Declaring an account to be the selling agency is a main admin's
        // decision. Without this line the self-update path below would let any
        // account grant itself the agency's write access.
        && (request.resource.data.get('agency', false) == resource.data.get('agency', false) || iAmMainAdmin())
        && (
          (request.auth.uid == userId
            && (unchanged('role') || (isAdmin() && !isOwnerEmail(resource.data)))
            && request.resource.data.get('disabled', false) == resource.data.get('disabled', false))
          ||
          (isAdmin() && request.auth.uid != userId
            && !isOwnerEmail(resource.data)
            && (!isMainAdmin(resource.data) || iAmMainAdmin()))
        );

      // The owner can never be deleted. An admin may delete themselves, or delete
      // another account (a main admin only when the remover is also a main admin).
      allow delete: if isSignedIn() && !isOwnerEmail(resource.data) && (
        (request.auth.uid == userId && isAdmin()) ||
        (isAdmin() && request.auth.uid != userId && (!isMainAdmin(resource.data) || iAmMainAdmin()))
      );
    }

    // ── inviteCodes ── (doc ID == the code itself; admin-managed platform-wide)
    match /inviteCodes/{code} {
      // Readable pre-auth so a prospective user can validate a code before signing up.
      // Listing is blocked so codes can't be enumerated in bulk.
      allow get: if true;
      allow list: if isAdmin();

      allow create: if isAdmin();

      // A brand-new signed-in user may claim an unused code as themselves;
      // an admin may otherwise manage any code.
      allow update: if isSignedIn() && (
        (
          resource.data.usedBy == null &&
          request.resource.data.usedBy == request.auth.uid &&
          unchanged('role') && unchanged('code')
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── private, per-account business data ──
    // Reads are scoped to the owner (cheap). Writes additionally require the
    // account to be active, so a disabled user can't keep changing data.
    // Owner reads + writes their own; an admin may READ any account (read-only
    // inspection for support) but can never write another account's data
    // (writes still require isActiveOwner, i.e. workspaceId == the writer's uid).
    match /apartments/{id} {
      allow read: if isOwner(resource.data) || isAdmin();
      allow create: if isActiveOwner(request.resource.data);

      // bookedNights is the night index that makes double booking impossible
      // rather than unlikely — see addBooking in src/stores/bookings.js. The
      // agency must be able to write it, because it books into this apartment
      // too; it may write NOTHING else here, so the name, price and capacity
      // stay entirely the owner's.
      allow update: if (isActiveOwner(resource.data) && unchanged('workspaceId'))
        || (isAgencyFor(resource.data.workspaceId) && changedOnly(['bookedNights']));

      allow delete: if isActiveOwner(resource.data);
    }

    match /bookings/{id} {
      allow read: if isOwner(resource.data) || isAdmin();

      // Either the account's own owner, or the agency writing a booking stamped
      // as theirs. An owner's app never writes those stamp fields, so the two
      // kinds of booking can always be told apart — which is the whole point:
      // the account's turnover is all of them, the agency's sales are only its
      // own.
      allow create: if isActiveOwner(request.resource.data)
        || isAgencyBooking(request.resource.data);

      // The agency may correct or cancel what it brought. It may not rewrite
      // whose booking it is, nor move it to another account.
      allow update: if (isActiveOwner(resource.data) && unchanged('workspaceId'))
        || (
          isMyAgencyBooking()
          && unchanged('workspaceId')
          && unchanged('source')
          && unchanged('createdVia')
          && unchanged('createdByAgency')
          && unchanged('mseeReservationId')
        );

      // Deleting stays with the owner. The agency cancels, which keeps the
      // record of a booking that existed and then did not happen.
      allow delete: if isActiveOwner(resource.data);
    }

    match /guests/{id} {
      allow read: if isOwner(resource.data) || isAdmin();
      allow create: if isActiveOwner(request.resource.data);
      allow update: if isActiveOwner(resource.data) && unchanged('workspaceId');
      allow delete: if isActiveOwner(resource.data);
    }

    // ── notes ── (a private channel between an account and platform admins)
    // The workspace owner and any admin can read them. The owner may write notes
    // in their own workspace; an admin may write notes into any workspace (e.g.
    // to leave a message for that user). A user can delete only notes they wrote;
    // an admin can delete any.
    match /notes/{id} {
      allow read: if isSignedIn() && (isOwner(resource.data) || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.workspaceId is string &&
        request.resource.data.text is string && (
          (isActiveOwner(request.resource.data) && request.resource.data.authorId == request.auth.uid) ||
          isAdmin()
        );

      allow update, delete: if isSignedIn() && (
        (isOwner(resource.data) && resource.data.authorId == request.auth.uid) ||
        isAdmin()
      );
    }
  }
}
